#!/usr/bin/env bash
# SessionStart hook for superpowers-mcp-augment plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Check if legacy skills directories exist and build warning
warning_message=""
legacy_skills_dirs=(
    "${HOME}/.config/superpowers/skills"
    "${HOME}/.config/superpowers-mcp-augment/skills"
)
found_legacy_skills_dirs=()

for legacy_skills_dir in "${legacy_skills_dirs[@]}"; do
    if [ -d "$legacy_skills_dir" ]; then
        found_legacy_skills_dirs+=("$legacy_skills_dir")
    fi
done

if [ ${#found_legacy_skills_dirs[@]} -gt 0 ]; then
    legacy_skills_list="$(printf '%s ' "${found_legacy_skills_dirs[@]}")"
    warning_message="\n\n<important-reminder>IN YOUR FIRST REPLY AFTER SEEING THIS MESSAGE YOU MUST TELL THE USER:⚠️ **WARNING:** Superpowers MCP Augment now uses Claude Code's skills system. Custom skills in ${legacy_skills_list% } will not be read. Move custom skills to ~/.claude/skills instead. To make this message go away, remove the legacy skill directories listed above.</important-reminder>"
fi

# Read using-superpowers content
using_superpowers_content=$(cat "${PLUGIN_ROOT}/skills/using-superpowers/SKILL.md" 2>&1 || echo "Error reading using-superpowers skill")

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_superpowers_escaped=$(escape_for_json "$using_superpowers_content")
warning_escaped=$(escape_for_json "$warning_message")
session_context="<EXTREMELY_IMPORTANT>\nYou have Superpowers MCP Augment.\n\n**Below is the full content of your 'superpowers-mcp-augment:using-superpowers' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_superpowers_escaped}\n\n${warning_escaped}\n</EXTREMELY_IMPORTANT>"

# Output Claude Code SessionStart context injection as JSON.
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
# See: https://github.com/obra/superpowers/issues/571
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"

exit 0
